# ─────────────────────────────────────────────────────────────
# .env.example — Copie para .env e preencha com seus valores
# NUNCA versione o arquivo .env real no Git!
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=appuser
POSTGRES_PASSWORD=troque_esta_senha_segura
POSTGRES_DB=appdb

# ── URL de conexão (montada automaticamente pelo Compose) ─────
# Não é necessário alterar se usar os valores acima
DATABASE_URL=postgresql://appuser:troque_esta_senha_segura@postgres:5432/appdb
